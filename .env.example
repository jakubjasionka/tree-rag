# Tree-RAG — Hierarchical Scoped Memory Engine Configuration (RFC 2606 Placeholders)

# Base directory for workspace sub-indices (<workspace>/index.faiss + docs.json) and _pending queue
TREE_RAG_BASE_DIR=./.treerag_data

# Default active workspace (branch namespace) when not explicitly specified
TREE_RAG_DEFAULT_WORKSPACE=default
MEMORY_WORKSPACE=default

# OpenAI-compatible CPU embedding server endpoint (e.g. intfloat/multilingual-e5-small, 384-d, 0 MB GPU VRAM)
# When unset, scoped_memory.mcp_server and dashboard fall back to deterministic MockEmbedder
TREE_RAG_EMBED_URL=http://127.0.0.1:8089/v1
EMBED_URL=http://embed.example:PORT/v1

# Optional secondary 4096-dim embedding endpoint (configured via env for high-dim 'plus' mode)
TREE_RAG_EMBED_URL_PLUS=http://127.0.0.1:8090/v1

# HTTP timeout in seconds for embedding requests
MEMORY_EMBED_TIMEOUT=15.0

# Optional comma-separated process patterns for read-only concurrency guard (default: disabled)
TREE_RAG_CONCURRENCY_PATTERNS=

# Memory MCP Hub standalone Node.js dashboard port & bind host
TREE_RAG_DASHBOARD_PORT=8095
TREE_RAG_DASHBOARD_HOST=127.0.0.1

# Generic model identifier sent to the CPU embedding endpoint
TREE_RAG_EMBED_MODEL=compact-multilingual-cpu-100m

# Vector dimensionality expected from the configured embedding model
TREE_RAG_EMBED_DIM=384

# Batch size used during atomic embedding model swaps (execute_swap)
TREE_RAG_SWAP_BATCH_SIZE=8

# Minimum cosine similarity score (0.0 - 1.0) required before returning local workspace results
TREE_RAG_MIN_SCORE=0.25

# Set to 1 to bypass read-only concurrency guard during forced pending-queue merge
MEMORY_GUARD_DISABLE=0

# Optional client identifier appended to document provenance metadata
MEMORY_CLIENT_ID=agent-cli

# Optional peer node endpoint for conflict-free multi-node synchronization
TREE_RAG_PEER_URL=http://peer-node.example:PORT/v1

# Standalone RAG sync transport backend (local|http)
TREE_RAG_SYNC_TRANSPORT=local|http

# Conflict resolution policy during standalone RAG sync (union|first|last)
TREE_RAG_SYNC_CONFLICT_POLICY=union|first|last
